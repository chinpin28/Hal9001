    static void printBar(String strLabel, int intValue, int intMax, boolean bolInverted)
    {
        int intFilled = (int) Math.round((double) intValue / intMax * 10);

        StringBuilder strBar = new StringBuilder("[");
        for (int i = 0; i < 10; i++)
        {
            if (i < intFilled)
            {
                strBar.append("█");
            }
            else
            {
                strBar.append(" ");
            }
        }
        strBar.append("]");

        double dblRatio = (double) intValue / intMax;
        String strStatusLabel;
        String strColor;

        if (!bolInverted)
        {
            if (dblRatio <= 0.2)
            {
                strStatusLabel = "CRITICAL";
                strColor = RED;
            }
            else if (dblRatio <= 0.4)
            {
                strStatusLabel = "LOW";
                strColor = YELLOW;
            }
            else if (dblRatio <= 0.6)
            {
                strStatusLabel = "OK";
                strColor = BLUE;
            }
            else if (dblRatio <= 0.8)
            {
                strStatusLabel = "GOOD";
                strColor = GREEN;
            }
            else
            {
                strStatusLabel = "HIGH";
                strColor = GREEN;
            }
        }
        else
        {
            if (dblRatio <= 0.2)
            {
                strStatusLabel = "LOW";
                strColor = GREEN;
            }
            else if (dblRatio <= 0.6)
            {
                strStatusLabel = "OK";
                strColor = BLUE;
            }
            else if (dblRatio <= 0.8)
            {
                strStatusLabel = "HIGH";
                strColor = YELLOW;
            }
            else
            {
                strStatusLabel = "CRITICAL";
                strColor = RED;
            }
        }

        System.out.printf("  %-8s: %s%s%s %3d/%-3d %s%s%s%n",
                strLabel, strColor, strBar.toString(), RESET,
                intValue, intMax, strColor, strStatusLabel, RESET);
    }

    static int getIntInRange(Scanner sc, String strPrompt, int intMin, int intMax)
    {
        int intValue = intMin - 1;
        boolean bolValid = false;

        while (!bolValid)
        {
            System.out.print(strPrompt);

            try
            {
                intValue = sc.nextInt();
                sc.nextLine();

                if (intValue >= intMin && intValue <= intMax)
                {
                    bolValid = true;
                }
                else
                {
                    System.out.println(YELLOW + "  Please enter a number between "
                            + intMin + " and " + intMax + "." + RESET);
                }
            }
            catch (InputMismatchException e)
            {
                System.out.println(YELLOW + "  Invalid input. Please enter a whole number." + RESET);
                sc.nextLine();
            }
        }

        return intValue;
    }

    static char getCharChoice(Scanner sc, String strPrompt)
    {
        System.out.print(strPrompt);
        String strInput = sc.nextLine().trim().toUpperCase();

        if (strInput.length() == 0)
        {
            return ' ';
        }

        return strInput.charAt(0);
    }

    static int limitStat(int intValue)
    {
        if (intValue < 0)
        {
            return 0;
        }
        if (intValue > 10)
        {
            return 10;
        }
        return intValue;
    }

    static int limitResource(int intValue)
    {
        if (intValue < 0)
        {
            return 0;
        }
        if (intValue > 100)
        {
            return 100;
        }
        return intValue;
    }

