    /** Sets starting resources based on difficulty choice. */
    static void applyDifficulty(int intDifficulty) {
        if (intDifficulty == 1) {
            intOxygen = 95; intFood = 95; intWater = 95;
            intCrops  = 90; intMorale = 85;
            halSay("Easy mode confirmed. Resource reserves are well-stocked.");
        } else if (intDifficulty == 2) {
            // Normal - defaults already set
            halSay("Normal mode confirmed. Standard mission loadout active.");
        } else {
            intOxygen = 60; intFood = 55; intWater = 55;
            intCrops  = 45; intMorale = 50;
            halSay("Hard mode confirmed. Resources are limited. Choose wisely.");
        }
    }

    /** Prompts for crew names, generates IDs, assigns shifts and default stats. */
    static void setupCrew() {
        for (int intCount = 0; intCount < intCrewCount; intCount++) {
            System.out.print("  Enter name for crewmate " + (intCount + 1) + ": ");
            arrNames[intCount]      = sc.nextLine().trim();
            arrIDs[intCount]        = "C" + (100 + rng.nextInt(900));
            chrShifts[intCount]     = (intCount % 2 == 0) ? 'A' : 'B';
            intMood[intCount]       = 10;
            intEnergy[intCount]     = 10;
            intStress[intCount]     = 0;
            intHunger[intCount]     = 0;
            intHealth[intCount]     = 10;
            intTasksToday[intCount] = 0;
            System.out.println("  > " + arrNames[intCount]
                    + "  |  ID: " + arrIDs[intCount]
                    + "  |  Shift: " + chrShifts[intCount]);
        }
    }

