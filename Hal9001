    static int intFood   = 80;
    static int intWater  = 80;
    static int intCrops  = 70;
    static int intMorale = 70;

    // -------------------------------------------------------------------------
    // MISSION STATE
    // -------------------------------------------------------------------------
    static int     intMissionDay = 1;
    static boolean bolGameOver   = false;

    // -------------------------------------------------------------------------
    // CREW ARRAYS  (max 10 crewmates)
    // -------------------------------------------------------------------------
    static int intCrewCount = 0;

    static String[] arrNames      = new String[10];
    static String[] arrIDs        = new String[10];
    static char[]   chrShifts     = new char[10];   // 'A' or 'B'
    static int[]    intMood       = new int[10];     // 0 - 10
    static int[]    intEnergy     = new int[10];     // 0 - 10
    static int[]    intStress     = new int[10];     // 0 - 10
    static int[]    intHunger     = new int[10];     // 0 - 10
    static int[]    intHealth     = new int[10];     // 0 - 10
    static int[]    intTasksToday = new int[10];     // 0 - 2

    // -------------------------------------------------------------------------
    // JOURNAL QUOTES
    // -------------------------------------------------------------------------
    static String[] arrJournalQuotes = {
        "I miss seeing real sunlight.",
        "The stars look peaceful today.",
        "The routine helps, but I feel tired.",
        "The crops make the ship feel alive.",
        "I hope HAL keeps checking in on us.",
        "Floating in zero-g still makes me smile.",
        "Sometimes I wonder what home looks like now.",
        "The hum of the engines is oddly comforting.",
        "I dreamed about rain last night.",
        "We are further from Earth than any human has been. That means something."
    };

    // =========================================================================
    // MAIN METHOD
    // =========================================================================
    public static void main(String[] args) {

        printIntro();

        // --- Difficulty ---
        printBoxHeader("SELECT DIFFICULTY");
        System.out.println("  1. Easy   (higher starting resources)");
        System.out.println("  2. Normal (medium starting resources)");
        System.out.println("  3. Hard   (lower starting resources)");
        int intDifficulty = getIntInRange(sc, "  Enter choice (1-3): ", 1, 3);
        applyDifficulty(intDifficulty);

        // --- Crew setup ---
        printBoxHeader("CREW REGISTRATION");
        intCrewCount = getIntInRange(sc, "  How many crewmates? (1-10): ", 1, 10);
        setupCrew();

        halSay("Crew registered. HAL 9001 fully online. Mission beginning on Day 1.");
        pressEnter();

        // =====================================================================
        // MAIN GAME LOOP
        // =====================================================================
        while (!bolGameOver) {

            // Win check
            if (intMissionDay > 30) {
                printVictory();
                bolGameOver = true;
                break;
            }

            // Loss check
            String strLossReason = checkLossConditions();
            if (strLossReason != null) {
                printLoss(strLossReason);
                bolGameOver = true;
                break;
            }

            // Critical resource warnings printed before main menu
            printResourceWarnings();

            printDayHeader();
            char chrChoice = getCharChoice(sc, "  Enter choice: ");

            switch (chrChoice) {
                case 'A': viewCrewStatus();     break;
                case 'B': viewShipResources();  break;
                case 'C': offerDailyTask();     break;
                case 'D': scheduleRecreation(); break;
                case 'E': halRecommendations(); break;
                case 'F': crewSupportEvent();   break;
                case 'G': emergencyEvent();     break;
                case 'H': crewJournalEntry();   break;
                case 'I': endMissionDay();      break;
                case 'J':
                    halSay("Initiating shutdown sequence. Safe travels, crew.");
                    bolGameOver = true;
                    break;
                // --- NEW FEATURES ---
                case 'K': workoutPlanner();     break;
                case 'L': mealTracker();        break;
                case 'M': restPlanner();        break;
                case 'N': cropCareSystem();     break;
                case 'O': crewCheckIn();        break;
                default:
                    halSay("Unrecognized command. Please choose A through O.");
            }

            if (!bolGameOver) pressEnter();
        }

        System.out.println("\n  [ HAL 9001 OFFLINE ]\n");
        sc.close();
    }

