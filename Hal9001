    // =========================================================================
    // E - HAL RECOMMENDATIONS
    // =========================================================================
    static void halRecommendations() {
        printBoxHeader("HAL RECOMMENDATIONS");
        halSay("I have reviewed the current crew conditions. Support intervention may be required.");

        for (int intCount = 0; intCount < intCrewCount; intCount++) {
            System.out.println("\n  " + arrNames[intCount] + " [" + arrIDs[intCount] + "]:");
            boolean bolIssue = false;
            if (intStress[intCount] >= 8) {
                System.out.println("    ! High stress. Reduce workload and schedule recreation.");
                bolIssue = true;
            }
            if (intEnergy[intCount] <= 3) {
                System.out.println("    ! Low energy. Assign rest or lighter tasks.");
                bolIssue = true;
            }
            if (intMood[intCount] <= 4) {
                System.out.println("    ! Low mood. Increase social support or recreation.");
                bolIssue = true;
            }
            if (intHunger[intCount] >= 7) {
                System.out.println("    ! High hunger. Use Meal Tracker [L] soon.");
                bolIssue = true;
            }
            if (intHealth[intCount] <= 4) {
                System.out.println("    ! Poor health. Reduce duties and allow recovery.");
                bolIssue = true;
            }
            if (!bolIssue) System.out.println("    Condition stable. No intervention required.");
        }

        System.out.println("\n  --- Ship-Wide Systems ---");
        boolean bolShipIssue = false;
        if (intOxygen < 40) { System.out.println("  ! Oxygen critically low. Repair immediately.");  bolShipIssue = true; }
        if (intFood   < 40) { System.out.println("  ! Food supply critical. Prioritize crop care."); bolShipIssue = true; }
        if (intWater  < 40) { System.out.println("  ! Water reserves low. Conserve and restock.");   bolShipIssue = true; }
        if (intCrops  < 40) { System.out.println("  ! Crop health declining. Assign monitoring.");   bolShipIssue = true; }
        if (intMorale < 40) { System.out.println("  ! Crew morale is low. Schedule recreation.");    bolShipIssue = true; }
        if (!bolShipIssue)    System.out.println("  All ship systems stable. Nominal operation confirmed.");
    }

    // =========================================================================
    // F - CREW SUPPORT EVENT
    // =========================================================================
    static void crewSupportEvent() {
        printBoxHeader("CREW SUPPORT EVENT");
        int intIndex = rng.nextInt(intCrewCount);
        halSay("Support intervention may be required for " + arrNames[intIndex] + ".");
        System.out.println("\n  " + arrNames[intIndex] + " sends HAL a private status report.");
        System.out.println("  \"" + arrNames[intIndex] + " feels overwhelmed by the mission routine.\"");
        System.out.println("\n  How should HAL respond?");
        System.out.println("    1. Suggest rest and reduce task load");
        System.out.println("    2. Encourage them to continue working");
        System.out.println("    3. Schedule group recreation");
        System.out.println("    4. Ignore the report");
        int intChoice = getIntInRange(sc, "  Enter choice (1-4): ", 1, 4);
        switch (intChoice) {
            case 1:
                halSay("Rest recommended for " + arrNames[intIndex] + ". Adjusting schedule.");
                intStress[intIndex] = limitStat(intStress[intIndex] - 3);
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] + 2);
                intMood[intIndex]   = limitStat(intMood[intIndex]   + 1);
                intMorale           = limitResource(intMorale + 3);
                break;
            case 2:
                halSay("Encouraging continued work. Note: pushing through fatigue has risks.");
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                break;
            case 3:
                halSay("Group recreation scheduled for the crew.");
                for (int intCount = 0; intCount < intCrewCount; intCount++) {
                    intMood[intCount]   = limitStat(intMood[intCount]   + 1);
                    intStress[intCount] = limitStat(intStress[intCount] - 1);
                }
                intMorale = limitResource(intMorale + 5);
                break;
            case 4:
                halSay("Report ignored. " + arrNames[intIndex] + " has noticed.");
                intMood[intIndex]   = limitStat(intMood[intIndex]   - 2);
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intMorale           = limitResource(intMorale - 4);
                break;
        }
    }

    // =========================================================================
    // G - EMERGENCY EVENT
    // =========================================================================
    static void emergencyEvent() {
        printBoxHeader("!!! EMERGENCY ALERT !!!");
        int intEvent = rng.nextInt(3) + 1;
        switch (intEvent) {
            case 1:
                System.out.println("  OXYGEN LEAK detected in Section C.");
                System.out.println("    1. Wake resting shift   (Oxygen +10, all Stress +1, all Energy -1)");
                System.out.println("    2. Use backup reserves  (Oxygen +6, Morale -3)");
                System.out.println("    3. Wait and monitor     (Oxygen -12)");
                int intOxyChoice = getIntInRange(sc, "  Enter choice (1-3): ", 1, 3);
                if (intOxyChoice == 1) {
                    intOxygen = limitResource(intOxygen + 10);
                    for (int i = 0; i < intCrewCount; i++) {
                        intStress[i] = limitStat(intStress[i] + 1);
                        intEnergy[i] = limitStat(intEnergy[i] - 1);
                    }
                    System.out.println("  > Leak contained. Oxygen +10.");
                } else if (intOxyChoice == 2) {
                    intOxygen = limitResource(intOxygen + 6);
                    intMorale = limitResource(intMorale - 3);
                    System.out.println("  > Backup used. Oxygen +6, Morale -3.");
                } else {
                    intOxygen = limitResource(intOxygen - 12);
                    System.out.println("  > Leak worsens. Oxygen -12.");
                }
                break;
            case 2:
                System.out.println("  HYDROPONIC CROPS are wilting.");
                System.out.println("    1. Immediate crop care  (Crops +10, Water -4)");
                System.out.println("    2. Use stored food      (Food -8, Morale +2)");
                System.out.println("    3. Ignore               (Crops -12, Food -4)");
                int intCropChoice = getIntInRange(sc, "  Enter choice (1-3): ", 1, 3);
                if (intCropChoice == 1) {
                    intCrops = limitResource(intCrops + 10);
                    intWater = limitResource(intWater - 4);
                    System.out.println("  > Crops tended. Crops +10, Water -4.");
                } else if (intCropChoice == 2) {
                    intFood   = limitResource(intFood - 8);
                    intMorale = limitResource(intMorale + 2);
                    System.out.println("  > Stored food deployed. Food -8, Morale +2.");
                } else {
                    intCrops = limitResource(intCrops - 12);
                    intFood  = limitResource(intFood  - 4);
                    System.out.println("  > Crops fail. Crops -12, Food -4.");
                }
                break;
            case 3:
                System.out.println("  CREW MORALE is dangerously low.");
                System.out.println("    1. Ship-wide recreation  (Morale +12, all Mood +2, all Stress -2)");
                System.out.println("    2. HAL supportive msg    (Morale +5)");
                System.out.println("    3. Continue routine      (Morale -8)");
                int intMoralChoice = getIntInRange(sc, "  Enter choice (1-3): ", 1, 3);
                if (intMoralChoice == 1) {
                    intMorale = limitResource(intMorale + 12);
                    for (int i = 0; i < intCrewCount; i++) {
                        intMood[i]   = limitStat(intMood[i]   + 2);
                        intStress[i] = limitStat(intStress[i] - 2);
                    }
                    System.out.println("  > Morale +12. Crew spirits lifting.");
                } else if (intMoralChoice == 2) {
                    intMorale = limitResource(intMorale + 5);
                    halSay("\"You are all doing an exceptional job. This mission matters. I am here.\"");
                } else {
                    intMorale = limitResource(intMorale - 8);
                    System.out.println("  > Tension unaddressed. Morale -8.");
                }
                break;
        }
    }

