    /**
     * Prints a visual stat/resource bar with a status label.
     *
     * bolInverted = false  (normal stats: high is good)
     *   CRITICAL <= 20%  |  LOW <= 40%  |  OK <= 60%  |  GOOD <= 80%  |  HIGH > 80%
     *
     * bolInverted = true  (Stress, Hunger: high is bad)
     *   LOW <= 20%  |  OK <= 60%  |  HIGH <= 80%  |  CRITICAL > 80%
     *
     * Example output:
     *   Mood  : [********  ] 8/10  GOOD
     *   Stress: [********  ] 8/10  HIGH
     */
    static void printBar(String strLabel, int intValue, int intMax, boolean bolInverted) {
        // Build the 10-segment fill bar
        int intFilled = (int) Math.round((double) intValue / intMax * 10);
        StringBuilder strBar = new StringBuilder("[");
        for (int i = 0; i < 10; i++) {
            strBar.append(i < intFilled ? "*" : " ");
        }
        strBar.append("]");

        // Choose the status label
        double dblRatio = (double) intValue / intMax;
        String strStatusLabel;
        if (!bolInverted) {
            if (dblRatio <= 0.2)      strStatusLabel = "CRITICAL";
            else if (dblRatio <= 0.4) strStatusLabel = "LOW";
            else if (dblRatio <= 0.6) strStatusLabel = "OK";
            else if (dblRatio <= 0.8) strStatusLabel = "GOOD";
            else                      strStatusLabel = "HIGH";
        } else {
            if (dblRatio <= 0.2)      strStatusLabel = "LOW";
            else if (dblRatio <= 0.6) strStatusLabel = "OK";
            else if (dblRatio <= 0.8) strStatusLabel = "HIGH";
            else                      strStatusLabel = "CRITICAL";
        }

        System.out.printf("  %s: %s %d/%d  %s%n",
                strLabel, strBar.toString(), intValue, intMax, strStatusLabel);
    }

    /**
     * Prompts the user for an integer in [intMin, intMax].
     * Uses try/catch to trap InputMismatchException.
     * Repeats until a valid value is entered.
     */
    static int getIntInRange(Scanner sc, String strPrompt, int intMin, int intMax) {
        int     intValue = intMin - 1;
        boolean bolValid = false;
        while (!bolValid) {
            System.out.print(strPrompt);
            try {
                intValue = sc.nextInt();
                sc.nextLine(); // consume leftover newline
                if (intValue >= intMin && intValue <= intMax) {
                    bolValid = true;
                } else {
                    System.out.println("  Please enter a number between "
                            + intMin + " and " + intMax + ".");
                }
            } catch (InputMismatchException e) {
                System.out.println("  Invalid input. Please enter a whole number.");
                sc.nextLine(); // discard the bad token
            }
        }
        return intValue;
    }

    /**
     * Reads one line of input, strips whitespace, converts to uppercase,
     * and returns the first character.
     */
    static char getCharChoice(Scanner sc, String strPrompt) {
        System.out.print(strPrompt);
        String strInput = sc.nextLine().trim().toUpperCase();
        if (strInput.length() == 0) return ' ';
        return strInput.charAt(0);
    }

    /**
     * Clamps a crew stat value to the range [0, 10].
     */
    static int limitStat(int intValue) {
        if (intValue < 0)  return 0;
        if (intValue > 10) return 10;
        return intValue;
    }

    /**
     * Clamps a ship resource value to the range [0, 100].
     */
    static int limitResource(int intValue) {
        if (intValue < 0)   return 0;
        if (intValue > 100) return 100;
        return intValue;
    }

    /**
     * Pauses the game loop until the user presses Enter.
     */
    static void pressEnter() {
        System.out.print("\n  [ Press Enter to continue... ]");
        sc.nextLine();
    }

