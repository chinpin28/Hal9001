    static void viewShipResources()
    {
        printBoxHeader("SHIP RESOURCES -- DAY " + intMissionDay, CYAN);
        printBar("Oxygen", intOxygen, 100, false);
        printBar("Food  ", intFood, 100, false);
        printBar("Water ", intWater, 100, false);
        printBar("Crops ", intCrops, 100, false);
        printBar("Morale", intMorale, 100, false);
    }

    static void offerDailyTask()
    {
        printBoxHeader("OFFER DAILY TASK", CYAN);

        char chrActiveShift = (intMissionDay % 2 != 0) ? 'A' : 'B';
        halSay("Only Shift " + chrActiveShift + " crewmates may be assigned tasks today.");

        int intIndex = pickCrewmate();

        if (chrShifts[intIndex] != chrActiveShift)
        {
            halSay(arrNames[intIndex] + " is on the resting shift. No tasks should be assigned.");
            return;
        }

        if (intTasksToday[intIndex] >= 2)
        {
            halSay(arrNames[intIndex] + " has completed 2 tasks today. Rest is recommended.");
            return;
        }

        System.out.println("\n  Assign a task to " + BOLD + arrNames[intIndex] + RESET + ":");
        System.out.println("  " + button("1", "Clean living quarters      Energy -1, Stress +1, Morale +3"));
        System.out.println("  " + button("2", "Monitor crops              Energy -1, Stress +1, Crops +5, Food +3"));
        System.out.println("  " + button("3", "Repair oxygen system       Energy -2, Stress +2, Oxygen +8"));
        System.out.println("  " + button("4", "Prepare meals              Energy -1, Hunger -3, Food -3, Morale +5"));
        System.out.println("  " + button("5", "Low-gravity workout        Energy -2, Health +2, Stress -1"));

        int intTask = getIntInRange(sc, "\n  Choose task (1-5): ", 1, 5);

        switch (intTask)
        {
            case 1:
                System.out.println("  > " + arrNames[intIndex] + " cleans the living quarters.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intStress[intIndex] = limitStat(intStress[intIndex] + 1);
                intMorale = limitResource(intMorale + 3);
                break;
            case 2:
                System.out.println("  > " + arrNames[intIndex] + " monitors the hydroponic crops.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intStress[intIndex] = limitStat(intStress[intIndex] + 1);
                intCrops = limitResource(intCrops + 5);
                intFood = limitResource(intFood + 3);
                break;
            case 3:
                System.out.println("  > " + arrNames[intIndex] + " repairs the oxygen system.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intOxygen = limitResource(intOxygen + 8);
                break;
            case 4:
                System.out.println("  > " + arrNames[intIndex] + " prepares meals for the crew.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intHunger[intIndex] = limitStat(intHunger[intIndex] - 3);
                intFood = limitResource(intFood - 3);
                intMorale = limitResource(intMorale + 5);
                break;
            case 5:
                System.out.println("  > " + arrNames[intIndex] + " completes a low-gravity workout.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                intHealth[intIndex] = limitStat(intHealth[intIndex] + 2);
                intStress[intIndex] = limitStat(intStress[intIndex] - 1);
                break;
        }

        intTasksToday[intIndex]++;
        halSay("Task logged. " + arrNames[intIndex]
                + " has completed " + intTasksToday[intIndex] + "/2 tasks today.");
    }

    static void scheduleRecreation()
    {
        printBoxHeader("SCHEDULE RECREATION", CYAN);
        halSay("Recreation is essential for crew wellbeing during long missions.");

        System.out.println("  " + button("1", "Movie night"));
        System.out.println("  " + button("2", "Group game"));
        System.out.println("  " + button("3", "Quiet reading time"));
        System.out.println("  " + button("4", "Space-viewing break"));

        int intChoice = getIntInRange(sc, "\n  Choose activity (1-4): ", 1, 4);
        String[] arrActivities = {"Movie night", "Group game", "Quiet reading time", "Space-viewing break"};

        System.out.println("\n  > " + arrActivities[intChoice - 1] + " scheduled for the crew.");

        for (int intCount = 0; intCount < intCrewCount; intCount++)
        {
            intMood[intCount] = limitStat(intMood[intCount] + 2);
            intStress[intCount] = limitStat(intStress[intCount] - 2);
            intEnergy[intCount] = limitStat(intEnergy[intCount] + 1);
        }

        intMorale = limitResource(intMorale + 8);
        System.out.println(GREEN + "  All crew: Mood +2, Stress -2, Energy +1. Ship Morale +8." + RESET);
    }

    static void halRecommendations()
    {
        printBoxHeader("HAL RECOMMENDATIONS", CYAN);
        halSay("I have reviewed the current crew conditions. Support intervention may be required.");

        for (int intCount = 0; intCount < intCrewCount; intCount++)
        {
            System.out.println("\n  " + BOLD + arrNames[intCount] + RESET + " [" + arrIDs[intCount] + "]:");
            boolean bolIssue = false;

            if (intStress[intCount] >= 8)
            {
                System.out.println(YELLOW + "    ! High stress. Reduce workload and schedule recreation." + RESET);
                bolIssue = true;
            }
            if (intEnergy[intCount] <= 3)
            {
                System.out.println(YELLOW + "    ! Low energy. Assign rest or lighter tasks." + RESET);
                bolIssue = true;
            }
            if (intMood[intCount] <= 4)
            {
                System.out.println(YELLOW + "    ! Low mood. Increase social support or recreation." + RESET);
                bolIssue = true;
            }
            if (intHunger[intCount] >= 7)
            {
                System.out.println(YELLOW + "    ! High hunger. Use Meal Tracker [L] soon." + RESET);
                bolIssue = true;
            }
            if (intHealth[intCount] <= 4)
            {
                System.out.println(YELLOW + "    ! Poor health. Reduce duties and allow recovery." + RESET);
                bolIssue = true;
            }
            if (!bolIssue)
            {
                System.out.println(GREEN + "    Condition stable. No intervention required." + RESET);
            }
        }

        System.out.println("\n  " + BOLD + "--- Ship-Wide Systems ---" + RESET);
        boolean bolShipIssue = false;

        if (intOxygen < 40)
        {
            System.out.println(RED + "  ! Oxygen critically low. Repair immediately." + RESET);
            bolShipIssue = true;
        }
        if (intFood < 40)
        {
            System.out.println(RED + "  ! Food supply critical. Prioritize crop care." + RESET);
            bolShipIssue = true;
        }
        if (intWater < 40)
        {
            System.out.println(RED + "  ! Water reserves low. Conserve and restock." + RESET);
            bolShipIssue = true;
        }
        if (intCrops < 40)
        {
            System.out.println(RED + "  ! Crop health declining. Assign monitoring." + RESET);
            bolShipIssue = true;
        }
        if (intMorale < 40)
        {
            System.out.println(RED + "  ! Crew morale is low. Schedule recreation." + RESET);
            bolShipIssue = true;
        }
        if (!bolShipIssue)
        {
            System.out.println(GREEN + "  All ship systems stable. Nominal operation confirmed." + RESET);
        }
    }

    static void crewSupportEvent()
    {
        printBoxHeader("CREW SUPPORT EVENT", CYAN);
        int intIndex = rng.nextInt(intCrewCount);

        halSay("Support intervention may be required for " + arrNames[intIndex] + ".");
        System.out.println("\n  " + arrNames[intIndex] + " sends HAL a private status report.");
        System.out.println("  \"" + arrNames[intIndex] + " feels overwhelmed by the mission routine.\"");

        System.out.println("\n  How should HAL respond?");
        System.out.println("  " + button("1", "Suggest rest and reduce task load"));
        System.out.println("  " + button("2", "Encourage them to continue working"));
        System.out.println("  " + button("3", "Schedule group recreation"));
        System.out.println("  " + button("4", "Ignore the report"));

        int intChoice = getIntInRange(sc, "\n  Enter choice (1-4): ", 1, 4);

        switch (intChoice)
        {
            case 1:
                halSay("Rest recommended for " + arrNames[intIndex] + ". Adjusting schedule.");
                intStress[intIndex] = limitStat(intStress[intIndex] - 3);
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] + 2);
                intMood[intIndex] = limitStat(intMood[intIndex] + 1);
                intMorale = limitResource(intMorale + 3);
                break;
            case 2:
                halSay("Encouraging continued work. Note: pushing through fatigue has risks.");
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                break;
            case 3:
                halSay("Group recreation scheduled for the crew.");
                for (int intCount = 0; intCount < intCrewCount; intCount++)
                {
                    intMood[intCount] = limitStat(intMood[intCount] + 1);
                    intStress[intCount] = limitStat(intStress[intCount] - 1);
                }
                intMorale = limitResource(intMorale + 5);
                break;
            case 4:
                halSay("Report ignored. " + arrNames[intIndex] + " has noticed.");
                intMood[intIndex] = limitStat(intMood[intIndex] - 2);
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intMorale = limitResource(intMorale - 4);
                break;
        }
    }

    static void emergencyEvent()
    {
        printBoxHeader("!!! EMERGENCY ALERT !!!", RED);
        int intEvent = rng.nextInt(3) + 1;

        switch (intEvent)
        {
            case 1:
                System.out.println(RED + "  OXYGEN LEAK detected in Section C." + RESET);
                System.out.println("  " + button("1", "Wake resting shift   Oxygen +10, all Stress +1, all Energy -1"));
                System.out.println("  " + button("2", "Use backup reserves  Oxygen +6, Morale -3"));
                System.out.println("  " + button("3", "Wait and monitor     Oxygen -12"));
                int intOxyChoice = getIntInRange(sc, "\n  Enter choice (1-3): ", 1, 3);

                if (intOxyChoice == 1)
                {
                    intOxygen = limitResource(intOxygen + 10);
                    for (int i = 0; i < intCrewCount; i++)
                    {
                        intStress[i] = limitStat(intStress[i] + 1);
                        intEnergy[i] = limitStat(intEnergy[i] - 1);
                    }
                    System.out.println(GREEN + "  > Leak contained. Oxygen +10." + RESET);
                }
                else if (intOxyChoice == 2)
                {
                    intOxygen = limitResource(intOxygen + 6);
                    intMorale = limitResource(intMorale - 3);
                    System.out.println(YELLOW + "  > Backup used. Oxygen +6, Morale -3." + RESET);
                }
                else
                {
                    intOxygen = limitResource(intOxygen - 12);
                    System.out.println(RED + "  > Leak worsens. Oxygen -12." + RESET);
                }
                break;

            case 2:
                System.out.println(YELLOW + "  HYDROPONIC CROPS are wilting." + RESET);
                System.out.println("  " + button("1", "Immediate crop care  Crops +10, Water -4"));
                System.out.println("  " + button("2", "Use stored food      Food -8, Morale +2"));
                System.out.println("  " + button("3", "Ignore               Crops -12, Food -4"));
                int intCropChoice = getIntInRange(sc, "\n  Enter choice (1-3): ", 1, 3);

                if (intCropChoice == 1)
                {
                    intCrops = limitResource(intCrops + 10);
                    intWater = limitResource(intWater - 4);
                    System.out.println(GREEN + "  > Crops tended. Crops +10, Water -4." + RESET);
                }
                else if (intCropChoice == 2)
                {
                    intFood = limitResource(intFood - 8);
                    intMorale = limitResource(intMorale + 2);
                    System.out.println(YELLOW + "  > Stored food deployed. Food -8, Morale +2." + RESET);
                }
                else
                {
                    intCrops = limitResource(intCrops - 12);
                    intFood = limitResource(intFood - 4);
                    System.out.println(RED + "  > Crops fail. Crops -12, Food -4." + RESET);
                }
                break;

            case 3:
                System.out.println(YELLOW + "  CREW MORALE is dangerously low." + RESET);
                System.out.println("  " + button("1", "Ship-wide recreation  Morale +12, all Mood +2, all Stress -2"));
                System.out.println("  " + button("2", "HAL supportive msg    Morale +5"));
                System.out.println("  " + button("3", "Continue routine      Morale -8"));
                int intMoralChoice = getIntInRange(sc, "\n  Enter choice (1-3): ", 1, 3);

                if (intMoralChoice == 1)
                {
                    intMorale = limitResource(intMorale + 12);
                    for (int i = 0; i < intCrewCount; i++)
                    {
                        intMood[i] = limitStat(intMood[i] + 2);
                        intStress[i] = limitStat(intStress[i] - 2);
                    }
                    System.out.println(GREEN + "  > Morale +12. Crew spirits lifting." + RESET);
                }
                else if (intMoralChoice == 2)
                {
                    intMorale = limitResource(intMorale + 5);
                    halSay("\"You are all doing an exceptional job. This mission matters. I am here.\"");
                }
                else
                {
                    intMorale = limitResource(intMorale - 8);
                    System.out.println(RED + "  > Tension unaddressed. Morale -8." + RESET);
                }
                break;
        }
    }

    static void crewJournalEntry()
    {
        printBoxHeader("CREW JOURNAL", CYAN);
        int intIndex = rng.nextInt(intCrewCount);
        int intQuote = rng.nextInt(arrJournalQuotes.length);

        System.out.println("\n  " + PURPLE + arrNames[intIndex] + RESET + " [" + arrIDs[intIndex] + "] writes:");
        System.out.println("  \"" + arrJournalQuotes[intQuote] + "\"");
        halSay("Entry logged. Monitoring crew wellbeing.");
    }

    static void endMissionDay()
    {
        printBoxHeader("END OF DAY " + intMissionDay + " -- SUMMARY", CYAN);
        viewShipResources();
        viewCrewStatus();

        halSay("Applying end-of-day changes. Please stand by.");

        intOxygen = limitResource(intOxygen - 4);
        intFood = limitResource(intFood - 4);
        intWater = limitResource(intWater - 4);
        intMorale = limitResource(intMorale - 2);

        for (int intCount = 0; intCount < intCrewCount; intCount++)
        {
            intEnergy[intCount] = limitStat(intEnergy[intCount] - 1);
            intStress[intCount] = limitStat(intStress[intCount] + 1);
            intHunger[intCount] = limitStat(intHunger[intCount] + 1);

            if (intStress[intCount] >= 9)
            {
                intHealth[intCount] = limitStat(intHealth[intCount] - 1);
                intMood[intCount] = limitStat(intMood[intCount] - 1);
                System.out.println(YELLOW + "  " + arrNames[intCount] + ": extreme stress penalty applied." + RESET);
            }
            if (intEnergy[intCount] <= 2)
            {
                intHealth[intCount] = limitStat(intHealth[intCount] - 1);
                intMood[intCount] = limitStat(intMood[intCount] - 1);
                System.out.println(YELLOW + "  " + arrNames[intCount] + ": exhaustion penalty applied." + RESET);
            }
            if (intHunger[intCount] >= 8)
            {
                intHealth[intCount] = limitStat(intHealth[intCount] - 1);
                intMood[intCount] = limitStat(intMood[intCount] - 1);
                System.out.println(YELLOW + "  " + arrNames[intCount] + ": hunger penalty applied." + RESET);
            }

            intTasksToday[intCount] = 0;
        }

        intMissionDay++;

        System.out.println();
        halSay("Recommendation for tomorrow:");

        if (intMorale < 50)
        {
            System.out.println("  > Schedule recreation early. Crew morale needs attention.");
        }
        else if (intFood < 50)
        {
            System.out.println("  > Prioritize crop care and meal planning. Food is low.");
        }
        else if (intOxygen < 50)
        {
            System.out.println("  > Repair oxygen systems soon. Supply is below optimal.");
        }
        else
        {
            System.out.println("  > Maintain a balanced workload. The crew is performing well.");
        }

        printTransitionScreen();
    }

