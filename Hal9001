    // =========================================================================
    // A - VIEW CREW STATUS
    // =========================================================================
    static void viewCrewStatus() {
        printBoxHeader("CREW STATUS  --  Day " + intMissionDay);
        halSay("I have reviewed the current crew conditions.");
        for (int intCount = 0; intCount < intCrewCount; intCount++) {
            System.out.println();
            System.out.println("  " + arrNames[intCount]
                    + "  [" + arrIDs[intCount] + "]"
                    + "  Shift: " + chrShifts[intCount]
                    + "  Tasks today: " + intTasksToday[intCount] + "/2");
            printBar("  Mood  ", intMood[intCount],   10, false);
            printBar("  Energy", intEnergy[intCount], 10, false);
            printBar("  Stress", intStress[intCount], 10, true);  // high = bad
            printBar("  Hunger", intHunger[intCount], 10, true);  // high = bad
            printBar("  Health", intHealth[intCount], 10, false);
        }
    }

    // =========================================================================
    // B - VIEW SHIP RESOURCES
    // =========================================================================
    static void viewShipResources() {
        printBoxHeader("SHIP RESOURCES  --  Day " + intMissionDay);
        printBar("  Oxygen", intOxygen, 100, false);
        printBar("  Food  ", intFood,   100, false);
        printBar("  Water ", intWater,  100, false);
        printBar("  Crops ", intCrops,  100, false);
        printBar("  Morale", intMorale, 100, false);
    }

    // =========================================================================
    // C - OFFER DAILY TASK
    // =========================================================================
    static void offerDailyTask() {
        printBoxHeader("OFFER DAILY TASK");
        char chrActiveShift = (intMissionDay % 2 != 0) ? 'A' : 'B';
        halSay("Only Shift " + chrActiveShift + " crewmates may be assigned tasks today.");

        int intIndex = pickCrewmate();

        // Check shift
        if (chrShifts[intIndex] != chrActiveShift) {
            halSay(arrNames[intIndex] + " is on the resting shift. No tasks should be assigned.");
            return;
        }

        // Check task limit
        if (intTasksToday[intIndex] >= 2) {
            halSay(arrNames[intIndex] + " has completed 2 tasks today. Rest is recommended.");
            return;
        }

        System.out.println("\n  Assign a task to " + arrNames[intIndex] + ":");
        System.out.println("    1. Clean living quarters      (Energy -1, Stress +1, Morale +3)");
        System.out.println("    2. Monitor crops              (Energy -1, Stress +1, Crops +5, Food +3)");
        System.out.println("    3. Repair oxygen system       (Energy -2, Stress +2, Oxygen +8)");
        System.out.println("    4. Prepare meals              (Energy -1, Hunger -3, Food -3, Morale +5)");
        System.out.println("    5. Low-gravity workout        (Energy -2, Health +2, Stress -1)");
        int intTask = getIntInRange(sc, "  Choose task (1-5): ", 1, 5);

        switch (intTask) {
            case 1:
                System.out.println("  > " + arrNames[intIndex] + " cleans the living quarters.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intStress[intIndex] = limitStat(intStress[intIndex] + 1);
                intMorale           = limitResource(intMorale + 3);
                break;
            case 2:
                System.out.println("  > " + arrNames[intIndex] + " monitors the hydroponic crops.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intStress[intIndex] = limitStat(intStress[intIndex] + 1);
                intCrops            = limitResource(intCrops + 5);
                intFood             = limitResource(intFood  + 3);
                break;
            case 3:
                System.out.println("  > " + arrNames[intIndex] + " repairs the oxygen system.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                intStress[intIndex] = limitStat(intStress[intIndex] + 2);
                intOxygen           = limitResource(intOxygen + 8);
                break;
            case 4:
                System.out.println("  > " + arrNames[intIndex] + " prepares meals for the crew.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 1);
                intHunger[intIndex] = limitStat(intHunger[intIndex] - 3);
                intFood             = limitResource(intFood - 3);
                intMorale           = limitResource(intMorale + 5);
                break;
            case 5:
                System.out.println("  > " + arrNames[intIndex] + " completes a low-gravity workout.");
                intEnergy[intIndex] = limitStat(intEnergy[intIndex] - 2);
                intHealth[intIndex] = limitStat(intHealth[intIndex] + 2);
                intStress[intIndex] = limitStat(intStress[intIndex] - 1);
                break;
        }

        intTasksToday[intIndex]++;
        halSay("Task logged. " + arrNames[intIndex]
                + " has completed " + intTasksToday[intIndex] + "/2 tasks today.");
    }

    // =========================================================================
    // D - SCHEDULE RECREATION
    // =========================================================================
    static void scheduleRecreation() {
        printBoxHeader("SCHEDULE RECREATION");
        halSay("Recreation is essential for crew wellbeing during long missions.");
        System.out.println("  1. Movie night");
