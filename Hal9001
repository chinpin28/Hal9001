        printBar("Mood  ", intMood[intIndex], 10, false);
        printBar("Energy", intEnergy[intIndex], 10, false);
        printBar("Stress", intStress[intIndex], 10, true);
        printBar("Hunger", intHunger[intIndex], 10, true);
        printBar("Health", intHealth[intIndex], 10, false);

        boolean bolIssueFound = false;

        if (intStress[intIndex] >= 7)
        {
            halSay(arrNames[intIndex] + " is experiencing high stress.");
            System.out.println("  Recommendation: Use Rest Planner [M] or Schedule Recreation [D].");
            bolIssueFound = true;
        }
        if (intEnergy[intIndex] <= 3)
        {
            halSay(arrNames[intIndex] + " has critically low energy.");
            System.out.println("  Recommendation: Use Rest Planner [M] or Meal Tracker [L].");
            bolIssueFound = true;
        }
        if (intHunger[intIndex] >= 6)
        {
            halSay(arrNames[intIndex] + " is experiencing significant hunger.");
            System.out.println("  Recommendation: Use Meal Tracker [L] as soon as possible.");
            bolIssueFound = true;
        }
        if (intMood[intIndex] <= 4)
        {
            halSay(arrNames[intIndex] + "'s mood is low.");
            System.out.println("  Recommendation: Use Crew Support Event [F] or Schedule Recreation [D].");
            bolIssueFound = true;
        }
        if (intHealth[intIndex] <= 4)
        {
            halSay(arrNames[intIndex] + "'s health is deteriorating.");
            System.out.println("  Recommendation: Use Rest Planner [M] and assign lighter tasks only.");
            bolIssueFound = true;
        }

        if (!bolIssueFound)
        {
            halSay(arrNames[intIndex] + " is doing well. No immediate intervention required.");
        }
    }

    static String checkLossConditions()
    {
        if (intOxygen <= 0)
        {
            return "Oxygen supply depleted. The crew could not breathe.";
        }
        if (intFood <= 0)
        {
            return "Food supply exhausted. The crew could not be fed.";
        }
        if (intWater <= 0)
        {
            return "Water reserves gone. The crew could not survive.";
        }
        if (intMorale <= 0)
        {
            return "Ship morale collapsed. The crew lost hope.";
        }

        for (int intCount = 0; intCount < intCrewCount; intCount++)
        {
            if (intHealth[intCount] <= 0)
            {
                return arrNames[intCount] + "'s health reached zero. A crewmate was lost.";
            }
        }

        return null;
    }

