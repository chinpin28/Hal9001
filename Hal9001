    static void applyDifficulty(int intDifficulty)
    {
        if (intDifficulty == 1)
        {
            intOxygen = 95;
            intFood = 95;
            intWater = 95;
            intCrops = 90;
            intMorale = 85;
            halSay("Easy mode confirmed. Resource reserves are well-stocked.");
        }
        else if (intDifficulty == 2)
        {
            halSay("Normal mode confirmed. Standard mission loadout active.");
        }
        else
        {
            intOxygen = 60;
            intFood = 55;
            intWater = 55;
            intCrops = 45;
            intMorale = 50;
            halSay("Hard mode confirmed. Resources are limited. Choose wisely.");
        }
    }

    static void setupCrew()
    {
        for (int intCount = 0; intCount < intCrewCount; intCount++)
        {
            System.out.print("  Enter name for crewmate " + (intCount + 1) + ": ");
            arrNames[intCount] = sc.nextLine().trim();

            if (arrNames[intCount].length() == 0)
            {
                arrNames[intCount] = "Crewmate " + (intCount + 1);
            }

            arrIDs[intCount] = "C" + (100 + rng.nextInt(900));
            chrShifts[intCount] = (intCount % 2 == 0) ? 'A' : 'B';

            intMood[intCount] = 10;
            intEnergy[intCount] = 10;
            intStress[intCount] = 0;
            intHunger[intCount] = 0;
            intHealth[intCount] = 10;
            intTasksToday[intCount] = 0;

            System.out.println(GREEN + "  > Registered: " + RESET
                    + arrNames[intCount]
                    + "  |  ID: " + arrIDs[intCount]
                    + "  |  Shift: " + chrShifts[intCount]);
        }
    }

    static void printDashboard()
    {
        char chrActiveShift = (intMissionDay % 2 != 0) ? 'A' : 'B';

        System.out.println(CYAN + BOLD);
        System.out.println("  +================================================================+");
        System.out.printf( "  | %-22s | %-15s | %-17s |%n",
                "HAL 9001 COMMAND", "DAY " + intMissionDay, "SHIFT " + chrActiveShift);
        System.out.println("  +================================================================+");
        System.out.print(RESET);

        System.out.printf("  | O2: %-4s | FOOD: %-4s | WATER: %-4s | CROPS: %-4s | MORALE: %-4s |%n",
                intOxygen + "%", intFood + "%", intWater + "%", intCrops + "%", intMorale + "%");

        System.out.println(CYAN + "  +================================================================+" + RESET);
    }

