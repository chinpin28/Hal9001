            bolIssueFound = true;
        }
        if (intHunger[intIndex] >= 6) {
            halSay(arrNames[intIndex] + " is experiencing significant hunger.");
            System.out.println("  Recommendation: Use Meal Tracker [L] as soon as possible.");
            bolIssueFound = true;
        }
        if (intMood[intIndex] <= 4) {
            halSay(arrNames[intIndex] + "'s mood is low.");
            System.out.println("  Recommendation: Use Crew Support Event [F] or Schedule Recreation [D].");
            bolIssueFound = true;
