        System.out.println("  | " + button("A", "Crew Status       ") + " | " + button("B", "Ship Resources    ") + " |");
        System.out.println("  | " + button("C", "Daily Task        ") + " | " + button("D", "Recreation        ") + " |");
        System.out.println("  | " + button("E", "Recommendations   ") + " | " + button("F", "Support Event     ") + " |");
