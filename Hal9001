 * Version:     (May 10th, 2026)
 * Date:        May 2026
 */

import java.util.Scanner;
import java.util.Random;
import java.util.InputMismatchException;

public class Hal9001Game
{
    // Scanner and Random
    static Scanner sc = new Scanner(System.in);
    static Random rng = new Random();

    // ANSI colours
    static final String RESET = "\u001B[0m";
    static final String BOLD = "\u001B[1m";
    static final String DIM = "\u001B[2m";
    static final String RED = "\u001B[31m";
    static final String GREEN = "\u001B[32m";
    static final String YELLOW = "\u001B[33m";
    static final String BLUE = "\u001B[34m";
    static final String PURPLE = "\u001B[35m";
    static final String CYAN = "\u001B[36m";
    static final String WHITE = "\u001B[37m";

    // Ship resources
    static int intOxygen = 80;
    static int intFood = 80;
    static int intWater = 80;
    static int intCrops = 70;
    static int intMorale = 70;

    // Mission state
    static int intMissionDay = 1;
    static boolean bolGameOver = false;

    // Crew arrays
    static int intCrewCount = 0;
    static String[] arrNames = new String[10];
    static String[] arrIDs = new String[10];
    static char[] chrShifts = new char[10];
    static int[] intMood = new int[10];
    static int[] intEnergy = new int[10];
    static int[] intStress = new int[10];
    static int[] intHunger = new int[10];
    static int[] intHealth = new int[10];
    static int[] intTasksToday = new int[10];

    // Journal quotes
    static String[] arrJournalQuotes = {
        "I miss seeing real sunlight.",
        "The stars look peaceful today.",
        "The routine helps, but I feel tired.",
        "The crops make the ship feel alive.",
        "I hope HAL keeps checking in on us.",
        "Floating in zero-g still makes me smile.",
        "Sometimes I wonder what home looks like now.",
        "The hum of the engines is oddly comforting.",
        "I dreamed about rain last night.",
        "We are further from Earth than any human has been. That means something."
    };

    public static void main(String[] args)
    {
        clearScreen();
        printIntro();

        printBoxHeader("SELECT DIFFICULTY", CYAN);
        System.out.println(button("1", "Easy   - higher starting resources"));
        System.out.println(button("2", "Normal - medium starting resources"));
        System.out.println(button("3", "Hard   - lower starting resources"));
        int intDifficulty = getIntInRange(sc, CYAN + "\n  Enter choice (1-3): " + RESET, 1, 3);
        applyDifficulty(intDifficulty);

        printBoxHeader("CREW REGISTRATION", CYAN);
        intCrewCount = getIntInRange(sc, "  How many crewmates? (1-10): ", 1, 10);
        setupCrew();

        halSay("Crew registered. HAL 9001 fully online. Mission beginning on Day 1.");
        pressEnter();

        while (!bolGameOver)
        {
            if (intMissionDay > 30)
            {
                printVictory();
                bolGameOver = true;
                break;
            }

            String strLossReason = checkLossConditions();
            if (strLossReason != null)
            {
                printLoss(strLossReason);
                bolGameOver = true;
                break;
            }

            clearScreen();
            printResourceWarnings();
            printDashboard();
            printDayHeader();

            char chrChoice = getCharChoice(sc, CYAN + "\n  Select button A-O: " + RESET);

            clearScreen();

            switch (chrChoice)
            {
                case 'A':
                    viewCrewStatus();
                    break;
                case 'B':
                    viewShipResources();
                    break;
                case 'C':
                    offerDailyTask();
                    break;
                case 'D':
                    scheduleRecreation();
                    break;
                case 'E':
                    halRecommendations();
                    break;
                case 'F':
                    crewSupportEvent();
                    break;
                case 'G':
                    emergencyEvent();
                    break;
                case 'H':
                    crewJournalEntry();
                    break;
                case 'I':
                    endMissionDay();
                    break;
                case 'J':
                    halSay("Initiating shutdown sequence. Safe travels, crew.");
                    bolGameOver = true;
                    break;
                case 'K':
                    workoutPlanner();
                    break;
                case 'L':
                    mealTracker();
                    break;
                case 'M':
                    restPlanner();
                    break;
                case 'N':
                    cropCareSystem();
                    break;
                case 'O':
                    crewCheckIn();
                    break;
                default:
                    halSay("Unrecognized command. Please choose A through O.");
            }

            if (!bolGameOver)
            {
                pressEnter();
            }
        }

        System.out.println("\n  " + RED + "[ HAL 9001 OFFLINE ]" + RESET + "\n");
        sc.close();
    }

